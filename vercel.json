{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/lokatsiya",
      "destination": "/lokatsiya/index.html"
    },
    {
      "source": "/karta",
      "destination": "/lokatsiya/index.html"
    },
    {
      "source": "/((?!api/|lokatsiya|karta|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
